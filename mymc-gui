#!/usr/bin/env python3
"""Launch the mymc graphical user interface."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# Inside the AppImage, set up fonts before wx loads fontconfig.
import appimage_support
appimage_support.configure_fonts()

import gui

gui.run(sys.argv[1] if len(sys.argv) > 1 else None)
